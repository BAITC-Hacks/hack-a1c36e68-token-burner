{
  "$defs": {
    "DocumentInfo": {
      "properties": {
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "side": {
          "enum": [
            "before",
            "after"
          ],
          "title": "Side",
          "type": "string"
        },
        "pages": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pages"
        },
        "clause_count": {
          "title": "Clause Count",
          "type": "integer"
        },
        "parse_ok": {
          "default": true,
          "title": "Parse Ok",
          "type": "boolean"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "doc_id",
        "name",
        "side",
        "pages",
        "clause_count"
      ],
      "title": "DocumentInfo",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "clause_id": {
          "title": "Clause Id",
          "type": "string"
        },
        "quote": {
          "description": "Verbatim fragment of the clause text",
          "title": "Quote",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        }
      },
      "required": [
        "doc_id",
        "clause_id",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "loss",
            "transfer",
            "duplication",
            "conflict",
            "structure"
          ],
          "title": "Type",
          "type": "string"
        },
        "severity": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "function_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Function Ids",
          "type": "array"
        },
        "recommendation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommendation"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        },
        "rejection_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejection Reason"
        }
      },
      "required": [
        "id",
        "type",
        "severity",
        "summary",
        "evidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Function": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "object": {
          "title": "Object",
          "type": "string"
        },
        "area": {
          "title": "Area",
          "type": "string"
        },
        "owner_before": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Before"
        },
        "owner_after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner After"
        },
        "status": {
          "enum": [
            "preserved",
            "transferred",
            "changed",
            "lost",
            "duplicated"
          ],
          "title": "Status",
          "type": "string"
        },
        "conflict_of_interest": {
          "default": false,
          "title": "Conflict Of Interest",
          "type": "boolean"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "recommendation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommendation"
        }
      },
      "required": [
        "id",
        "action",
        "object",
        "area",
        "status"
      ],
      "title": "Function",
      "type": "object"
    },
    "Stats": {
      "properties": {
        "findings_total": {
          "default": 0,
          "title": "Findings Total",
          "type": "integer"
        },
        "verified": {
          "default": 0,
          "title": "Verified",
          "type": "integer"
        },
        "rejected": {
          "default": 0,
          "title": "Rejected",
          "type": "integer"
        }
      },
      "title": "Stats",
      "type": "object"
    },
    "TraceStep": {
      "properties": {
        "step": {
          "title": "Step",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "step",
        "started_at"
      ],
      "title": "TraceStep",
      "type": "object"
    },
    "Unit": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "created",
            "preserved",
            "transformed",
            "eliminated"
          ],
          "title": "Status",
          "type": "string"
        },
        "before_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of the unit/position in the 'before' set",
          "title": "Before Ref"
        },
        "after_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of the unit/position in the 'after' set",
          "title": "After Ref"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "Unit",
      "type": "object"
    }
  },
  "properties": {
    "documents": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DocumentInfo"
      },
      "title": "Documents",
      "type": "array"
    },
    "units": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Unit"
      },
      "title": "Units",
      "type": "array"
    },
    "functions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Function"
      },
      "title": "Functions",
      "type": "array"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "conclusion_md": {
      "default": "",
      "title": "Conclusion Md",
      "type": "string"
    },
    "stats": {
      "$ref": "#/$defs/Stats",
      "default": {
        "findings_total": 0,
        "verified": 0,
        "rejected": 0
      }
    },
    "analysis_complete": {
      "default": true,
      "title": "Analysis Complete",
      "type": "boolean"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "trace": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TraceStep"
      },
      "title": "Trace",
      "type": "array"
    }
  },
  "title": "AnalysisResult",
  "type": "object"
}
